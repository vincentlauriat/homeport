[Unit]
Description=Homeport — home server dashboard
Documentation=https://github.com/vincentlauriat/homeport
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homeport
Group=homeport
WorkingDirectory=/opt/homeport
# Port 80 without root. Override the port with HOMEPORT_PORT (drop the capability if >1024).
AmbientCapabilities=CAP_NET_BIND_SERVICE
Environment=HOMEPORT_CONFIG_DIR=/etc/homeport
Environment=HOMEPORT_DATA_DIR=/var/lib/homeport
Environment=HOMEPORT_PORT=80
# Docker read-only access via the socket proxy (see deploy/socket-proxy/). Comment out to
# disable Docker integration entirely.
Environment=HOMEPORT_DOCKER_HOST=tcp://127.0.0.1:2375
# MQTT credentials, if the mqtt section is enabled (root-only file, chmod 600):
EnvironmentFile=-/etc/homeport/mqtt.env
ExecStart=/bin/sh -c 'exec /opt/homeport/venv/bin/uvicorn homeport.main:app --host 0.0.0.0 --port "$HOMEPORT_PORT"'
Restart=on-failure
RestartSec=3

# Confinement. Volontairement modéré : les actions de redémarrage passent par sudo avec
# des commandes exactes (voir sudoers.example), et sudo est SUID. Les directives qui
# cassent ce chemin sont donc écartées sciemment :
#   NoNewPrivileges=yes    → interdit l'élévation, sudo échoue
#   RestrictSUIDSGID=yes   → même effet sur le binaire sudo
#   ProtectSystem=strict   → /var en lecture seule, sudo ne peut plus écrire son horodatage
# ProtectSystem=full met /usr et /boot en lecture seule tout en laissant /var écrivable,
# ce qui couvre l'essentiel sans toucher au chemin d'action.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
